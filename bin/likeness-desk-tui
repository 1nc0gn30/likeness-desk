#!/usr/bin/env python3
"""Likeness Desk v2.6.0 — Real-Status Unicode Braille TUI.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""

import argparse
import json
import os
import urllib.request

TOOL_VERSION = "2.6.0"
DEFAULT_PORT = int(os.environ.get("LIKENESS_PORT") or os.environ.get("PORT") or "9395")


def fetch_json(url: str, timeout: float = 2.0):
    req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": "likeness-desk-tui/2.6.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def query_daemon(port: int):
    base = f"http://127.0.0.1:{port}"
    health = None
    status = None
    online = False
    error = ""
    try:
        health = fetch_json(f"{base}/health")
        status = fetch_json(f"{base}/api/status")
        online = True
    except Exception as exc:
        error = str(exc)
    return {
        "tool": "likeness-desk",
        "title": "Likeness Desk (AI Video Double)",
        "version": TOOL_VERSION,
        "endpoint": base,
        "online": online,
        "error": error,
        "health": health or {},
        "status": status or {},
        "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
    }


def bar(fraction: float, width: int = 16) -> str:
    clamped = max(0.0, min(1.0, fraction))
    filled = int(round(clamped * width))
    return "⣿" * filled + "⣀" * (width - filled)


def main():
    ap = argparse.ArgumentParser(prog="likeness-desk-tui", description="Likeness Desk real-status Braille TUI")
    ap.add_argument("--version", action="version", version=f"likeness-desk-tui v{TOOL_VERSION}")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT, help="Coordinator port (default: 9395)")
    ap.add_argument("--status", action="store_true", help="Print concise one-line status and exit")
    ap.add_argument("--json", action="store_true", help="Output real daemon status JSON and exit")
    args, _unknown = ap.parse_known_args()

    snap = query_daemon(args.port)
    st = snap["status"]

    if args.json:
        print(json.dumps(snap, indent=2))
        return

    if args.status:
        state = "ONLINE" if snap["online"] else "OFFLINE"
        mode = st.get("mode", "offline") if snap["online"] else "offline"
        print(f"likeness-desk-tui v{TOOL_VERSION} | {snap['endpoint']} | {state} | mode={mode}")
        return

    online = snap["online"]
    voice_sec = float(st.get("voiceSeconds", 0) or 0)
    mouth = st.get("mouth") or {}
    mouth_str = (
        f"x={mouth['x']:.2f} y={mouth['y']:.2f} w={mouth['w']:.2f} h={mouth['h']:.2f}"
        if all(k in mouth for k in ("x", "y", "w", "h"))
        else "uncalibrated"
    )
    gpu_name = st.get("faceGpuName") or ("idle" if online else "offline")
    mode = st.get("mode", "offline") if online else "offline"

    print("\033[1;33m╭──────────────────────────────────────────────────────────────────────────╮\033[0m")
    print(f"\033[1;33m│\033[0m \033[1;37mLIKENESS DESK v{TOOL_VERSION:<6}\033[0m │ \033[36mNeal Frazier Tech (@1nc0gn30) • NullAI\033[0m      \033[1;33m│\033[0m")
    print("\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m")
    print(f"\033[1;33m│\033[0m  Daemon   : {snap['endpoint']:<28} State : {('ONLINE' if online else 'OFFLINE'):<18}\033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m  Mode     : {mode:<28} GPU   : {gpu_name[:18]:<18}\033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m  Voice    : {bar(min(1.0, voice_sec / 20.0), 16)}  {voice_sec:>4.1f}s  Trained: {str(bool(st.get('voiceTrained'))):<15}\033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m  Face/ROI : face={str(bool(st.get('face'))):<5} motion={str(bool(st.get('motion'))):<5}  {mouth_str[:29]:<29}\033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m  xAI Chat : {'enabled (XAI_API_KEY set)' if st.get('chat') else 'disabled (local-only mode)':<60}\033[1;33m│\033[0m")
    if not online:
        print(f"\033[1;33m│\033[0m  Note     : {'Start daemon: LIKENESS_LAZY_GPU=1 likeness-desk serve':<60}\033[1;33m│\033[0m")
    print("\033[1;33m╰──────────────────────────────────────────────────────────────────────────╯\033[0m")


if __name__ == "__main__":
    main()
